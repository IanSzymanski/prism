    "backdrops": {
     "prefer": [
      "motif",
      "dots",
      "rings",
      "grid",
      "bars",
      "glow"
     ],
     "say": {
      "rings": "concentric rings in the scene's second color, 8 px strokes at about 45 % opacity, centered off-frame at the top right and slowly expanding outward one after another, so three or four are always clearly in view"
     }
    },
    "transitions": {
     "add": {
      "wave": {
       "motif": "wave-stop",
       "out": "over its last {half} s a solid panel in {panel} rises from the {from} edge until it covers the frame; its leading edge is the brand wave: the motif's line cropped to the middle sixth around its burst, stretched to the frame width so the burst is about 260 px tall and 120 px wide, filled solid behind the line",
       "in": "it opens fully covered by that {panel} panel, which leaves toward the {to} edge over the first {half} s, its trailing edge the same brand wave",
       "from": "bottom",
       "to": "top"
      }
     },
     "after": {
      "main": "wave"
     }
    },
    "rules": [
     "Durations in days are shown as a calendar: a month or week grid with the counted days highlighted in the scene's main color, never as rows of squares, tallies or bars.",
     "No free-flowing shapes or blobs, in backdrops or as drawn objects.",
     "Accent words are never underlined; a highlight band behind an accent word is the light gradient's deepest color.",
     "Magenta and the dark blue accent are never used."
    ]
   }
