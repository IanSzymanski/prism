 "generators": {
  "wave": {
   "script": "assets/Wave/wave-core.js",
   "global": "Wave",
   "function": "samples",
   "params": {
    "default": {
     "wavelength": 11.7,
     "amplitude": 21.95,
     "focus": 8.44,
     "edge": 90,
     "span": 180,
     "_scale": "Multiply every length by the output's unit s."
    },
    "email-divider": {
     "wavelength": 11.7,
     "amplitude": 13,
     "focus": 8.44,
     "edge": 60,
     "span": 180
    }
   },
   "stroke": {
    "color": "prism-color-rule",
    "width": 1.3
   },
   "rules": [
    {
     "never": "beside",
     "of": [
      "person-photo",
      "person-name",
      "quote",
      "signature"
     ]
    },
    {
     "never": "above",
     "of": [
      "photo"
     ]
    },
    {
     "skip": "media-slide"
    },
    {
     "never": "through",
     "of": [
      "face"
     ]
    },
    {
     "max": 1,
     "per": "chapter",
     "kind": "stop"
    }
   ]
  }
