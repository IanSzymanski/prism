 "library": {
  "_note": "Reusable photos uploaded to the design system's Photos group. Each id is used as ![Caption](brand:<id>); file is its path in the design system (assets/<group>/<file>). Only its upload id is pinned (snapshot.blobs); the photo stays in the design system and a piece fetches the ones it uses (run.sh library <brand> --need). shows, people (consent), orientation, focus (x% y%) and tags help formatters pick one.",
  "group": "Photos",
  "images": {}
 },
 "identity": {
  "_note": "Words that identify this brand. Core must never use them (tests/core-brand-free.test.py). The brand shares its name with the product, so only its motif is listed.",
  "terms": [
   "spectrum"
  ]
 },
 "motion": {
  "motifs": [
   {
    "id": "spectrum",
    "file": "snapshot/assets/Spectrum/spectrum-stop.svg",
    "on": "any",
    "say": "the brand's spectrum stop: four flat bands, always red, amber, green, blue in that order; it grows from the left. Never over a photo or a face, never behind text, one per frame"
   },
   {
    "id": "fan",
    "file": "snapshot/assets/Spectrum/fan-light.svg",
    "on": "light",
    "say": "the brand's fan: the four spectrum bands leaving the glyph toward the right edge; right third of the frame only, never behind text or over a photo"
   },
   {
    "id": "fan-dark",
    "file": "snapshot/assets/Spectrum/fan-dark.svg",
    "on": "dark",
    "say": "the brand's fan for dark grounds: the four spectrum bands leaving the glyph toward the right edge; right third of the frame only, never behind text or over a photo"
   }
  ]
 }
