 "generators": {
  "spectrum": {
   "script": "assets/Spectrum/spectrum-core.js",
   "module": "commonjs",
   "params": {
    "chip": {
     "width": 64,
     "height": 6
    },
    "stop": {
     "width": 96,
     "height": 6
    },
    "mini": {
     "width": 48,
     "height": 4
    },
    "thread": {
     "height": 12,
     "emphasis": 3
    },
    "section-rule": {
     "height": 3,
     "cycle": 4
    },
    "fan": {
     "startHeight": 40,
     "endHeight": 160
    }
   },
   "rules": [
    {
     "never": "over",
     "of": [
      "photo",
      "face"
     ]
    },
    {
     "never": "behind",
     "of": [
      "text"
     ]
    },
    {
     "max": 1,
     "per": "surface",
     "kind": "chip"
    },
    {
     "max": 1,
     "per": "chapter",
     "kind": "stop"
    },
    {
     "hue": "by-number",
     "of": [
      "section",
      "flow-step",
      "slide",
      "panel"
     ]
    }
   ]
  }
 },
